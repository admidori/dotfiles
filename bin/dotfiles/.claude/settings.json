{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(make test)",
      "Bash(zsh -n:*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)"
    ],
    "ask": [
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo rm:*)",
      "Read(**/.env*)",
      "Read(**/*secret*)",
      "Read(**/*token*)",
      "Edit(~/.git-hooks/**)",
      "Edit(~/dotfiles/bin/dotfiles/.git-hooks/**)",
      "Edit(~/.gitconfig)",
      "Edit(~/.gitconfig.local)",
      "Edit(~/.config/git/**)",
      "Edit(~/dotfiles/bin/dotfiles/.gitconfig)",
      "Edit(~/.local/bin/gitleaks)",
      "Edit(~/.local/bin/semgrep)",
      "Edit(~/.local/bin/osv-scanner)",
      "Edit(~/.local/bin/pre-commit)",
      "Edit(~/.local/share/pipx/venvs/semgrep/**)",
      "Edit(~/.local/share/pipx/venvs/pre-commit/**)",
      "Edit(~/.local/share/git-hooks/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.codex/config.toml)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/dotfiles/bin/dotfiles/.claude/hooks/**)",
      "Edit(~/.codex/hooks/**)",
      "Edit(~/dotfiles/bin/dotfiles/.codex/hooks/**)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/bash-guard.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline-command.sh"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agentPushNotifEnabled": true
}
