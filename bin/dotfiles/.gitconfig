[user]
	email = aoi.kondo@admidori.net
	name = Aoi Kondo

[alias]
	tree = log --graph --oneline --decorate=short --date=short

[core]
	editor = vim
	hooksPath = ~/.git-hooks

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

[include]
	path = ~/.gitconfig.local
