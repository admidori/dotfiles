#!/usr/bin/env bash
#
# Global pre-commit dispatcher.
# Runs core security checks on staged files (conflict markers, oversized files,
# secrets via gitleaks, code security via semgrep, shell linting via shellcheck,
# dependency vulnerabilities via osv-scanner).
# If all checks pass, chains to the repo-local pre-commit hook or pre-commit framework.
#
set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# shellcheck source=bin/dotfiles/.git-hooks/lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=bin/dotfiles/.git-hooks/lib/check-conflict-markers.sh
. "$SCRIPT_DIR/lib/check-conflict-markers.sh"
# shellcheck source=bin/dotfiles/.git-hooks/lib/check-large-files.sh
. "$SCRIPT_DIR/lib/check-large-files.sh"
# shellcheck source=bin/dotfiles/.git-hooks/lib/check-gitleaks.sh
. "$SCRIPT_DIR/lib/check-gitleaks.sh"
# shellcheck source=bin/dotfiles/.git-hooks/lib/check-semgrep.sh
. "$SCRIPT_DIR/lib/check-semgrep.sh"
# shellcheck source=bin/dotfiles/.git-hooks/lib/check-shellcheck.sh
. "$SCRIPT_DIR/lib/check-shellcheck.sh"
# shellcheck source=bin/dotfiles/.git-hooks/lib/check-osv.sh
. "$SCRIPT_DIR/lib/check-osv.sh"

# staged_files includes type changes (T), so replacing a symlink with a regular
# file is checked. Only regular blobs are exported for content scanners: a
# symlink would be checked out as a link and could point scanners, or the
# .semgrepignore reset, at files outside the repository.
staged_files=()
regular_files=()
raw_diff=()
mapfile -d '' raw_diff < <(git diff --cached --raw -z --no-renames --diff-filter=ACMT)
for ((i = 0; i + 1 < ${#raw_diff[@]}; i += 2)); do
  staged_files+=("${raw_diff[i + 1]}")
  read -r _ new_mode _ <<< "${raw_diff[i]}"
  case "$new_mode" in
    100644 | 100755) regular_files+=("${raw_diff[i + 1]}") ;;
  esac
done

tmp_staged=""
cleanup() {
  if [ -n "$tmp_staged" ] && [ -d "$tmp_staged" ]; then
    rm -rf "$tmp_staged"
  fi
}
trap cleanup EXIT

failed_checks=()

if ! check_conflict_markers "${staged_files[@]}"; then
  failed_checks+=("conflict markers")
fi

if ! check_large_files "${staged_files[@]}"; then
  failed_checks+=("oversized files")
fi

if ! check_gitleaks; then
  failed_checks+=("gitleaks")
fi

if [ "${#regular_files[@]}" -gt 0 ]; then
  tmp_staged="$(mktemp -d "${TMPDIR:-/tmp}/git-hooks-staged.XXXXXX")"
  export_staged_files "$tmp_staged" "${regular_files[@]}"

  if ! check_semgrep "$tmp_staged"; then
    failed_checks+=("semgrep")
  fi

  check_shellcheck "$tmp_staged" "${regular_files[@]}"

  if ! check_osv "$tmp_staged" "${regular_files[@]}"; then
    failed_checks+=("osv-scanner")
  fi
fi

if [ "${#failed_checks[@]}" -gt 0 ]; then
  echo "git-hooks: commit blocked: $(join_strings ", " "${failed_checks[@]}")" >&2
  exit 1
fi

if [ -n "$tmp_staged" ] && [ -d "$tmp_staged" ]; then
  rm -rf "$tmp_staged"
  tmp_staged=""
fi

chain_pre_commit "$@"
